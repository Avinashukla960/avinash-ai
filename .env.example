# ---------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
#
#   cp .env.example .env
#
# Then edit .env. NEVER commit .env to git (it's in .gitignore).
# ---------------------------------------------------------------------

# Your Cohere API key.
# Get one FREE at: https://dashboard.cohere.com/api-keys
# Free tier = 1000 API calls per month, no credit card needed.
COHERE_API_KEY=your-key-here

# Secret used to sign session cookies. Use any long random string.
# In a terminal you can generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-long-random-string

# The port the Express server will listen on. Defaults to 3000 if omitted.
PORT=3000
